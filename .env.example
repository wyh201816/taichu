# Right Code 统一模型服务配置；真实密钥只写入本机 .env
RIGHTCODE_API_KEY=your-token
RIGHTCODE_RESPONSES_BASE_URL=https://www.rightapi.ai/codex/v1
RIGHTCODE_CLAUDE_SALE_BASE_URL=https://www.rightapi.ai/claude
RIGHTCODE_DEEPSEEK_ANTHROPIC_BASE_URL=https://rightapi.ai/deepseek/anthropic
RIGHTCODE_DEFAULT_MODEL_ID=deepseek-v4-pro
RIGHTCODE_REQUEST_TIMEOUT_SECONDS=300
RIGHTCODE_MAX_RETRIES=2

# 可选模型价格（每百万 Token，CNY）；未配置时费用显示为“未配置价格”
# 支持字段：input、cached_input、output、reasoning_output、currency
RIGHTCODE_MODEL_PRICES_JSON={}

# RightCode 因网络、超时、限流或上游故障不可用时，自动降级到 DeepSeek 官方 V4 Pro
DEEPSEEK_API_KEY=your-deepseek-token
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_FALLBACK_ENABLED=true
DEEPSEEK_FALLBACK_MODEL_ID=deepseek-v4-pro
DEEPSEEK_FALLBACK_MAX_RETRIES=1

# 可选：为十二个专业子 Agent 的逻辑模型角色分别指定模型 ID
# 示例：{"drafting":"deepseek-v4-pro","revision":"gpt-5.2"}
AGENT_MODEL_ROLES_JSON={}

# 服务配置
HOST=127.0.0.1
PORT=8000
# 本地开发默认监听 src/taichu 下的 Python 变更并自动重载后端
BACKEND_RELOAD=true

# 单本小说数据目录
PROJECT_ASSETS_DIR=project_assets

# 知识沉淀效果评估配置；裁判模型留空时复用已配置的默认模型
EVALUATION_DATASETS_DIR=tests/fixtures/evaluations
EVALUATION_JUDGE_MODEL=

# Opik 只用于通用写作智能体 Benchmark 的链路追踪与数据集同步；默认关闭，不向外发送运行数据
OPIK_ENABLED=false
OPIK_PROJECT_NAME=taichu-general-agent-benchmark
# 自托管示例：http://localhost:5173/api；使用云端时填写 https://www.comet.com/opik/api
OPIK_URL_OVERRIDE=
OPIK_API_KEY=
OPIK_WORKSPACE=

# Milvus Vector Graph RAG：正文片段与已确认知识卡共用可重建的 Dense、BM25 与多跳图索引
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_PREFIX=taichu_story
MILVUS_HNSW_M=24
MILVUS_HNSW_EF_CONSTRUCTION=300
MILVUS_HNSW_EF_SEARCH=150
MILVUS_RRF_K=60

# Qwen3-Embedding-4B 由本机 llama.cpp 提供 OpenAI 兼容接口，不调用云端模型 API
EMBEDDING_SERVER_HOME=E:/Taichu/Runtime/llama.cpp/b10066
EMBEDDING_MODEL_PATH=E:/Taichu/Models/Qwen3-Embedding-4B/Qwen3-Embedding-4B-Q4_K_M.gguf
EMBEDDING_LOG_DIR=E:/Taichu/Embedding/log
EMBEDDING_SERVER_PORT=8011
EMBEDDING_BASE_URL=http://127.0.0.1:8011/v1
EMBEDDING_MODEL_ID=Qwen3-Embedding-4B-Q4_K_M
EMBEDDING_DIMENSIONS=2560
EMBEDDING_REQUEST_TIMEOUT_SECONDS=120
EMBEDDING_MAX_INPUT_TOKENS=8192
EMBEDDING_CONTEXT_SIZE=8192
EMBEDDING_BATCH_SIZE=8192
EMBEDDING_GPU_LAYERS=99

# Vector Graph RAG 通过太初统一 LLM 契约复用现有模型，只需选择模型 ID
# 该模型密钥独立配置，不会复用不兼容的 Responses 或 Anthropic 端点
VECTOR_GRAPH_LLM_MODEL=deepseek-v4-pro

# Markdown 正文切片与多跳召回参数；知识卡固定为一卡一个 passage
VECTOR_GRAPH_MANUSCRIPT_CHUNK_SIZE=1000
VECTOR_GRAPH_MANUSCRIPT_CHUNK_OVERLAP=200
VECTOR_GRAPH_PASSAGE_TOP_K=30
VECTOR_GRAPH_EXPANSION_MAX_SEED_ENTITIES=5
VECTOR_GRAPH_EXPANSION_MAX_SEED_RELATIONS=32
VECTOR_GRAPH_EXPANSION_MAX_HOP=1
VECTOR_GRAPH_EXPANSION_MAX_ENTITIES_PER_HOP=20
VECTOR_GRAPH_EXPANSION_RELATIONS_PER_ENTITY=10
VECTOR_GRAPH_EXPANSION_CANDIDATE_POOL_MULTIPLIER=4
VECTOR_GRAPH_EXPANSION_HUB_RELATIONS_PER_ENTITY=5
VECTOR_GRAPH_EXPANSION_HUB_DEGREE_THRESHOLD=100
VECTOR_GRAPH_EXPANSION_BEAM_WIDTH=24
VECTOR_GRAPH_EXPANSION_MAX_TOTAL_RELATIONS=56
VECTOR_GRAPH_EXPANSION_MAX_GRAPH_PASSAGES=20
VECTOR_GRAPH_RERANKER_TOP_K=10

# 本地 BGE 二阶段重排服务，由 infra/reranker/docker-compose.yml 启动
RERANKER_BASE_URL=http://127.0.0.1:8012
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_PATH=E:/Taichu/Models/bge-reranker-v2-m3
RERANKER_REQUEST_TIMEOUT_SECONDS=180

# 主 Agent 五级上下文流水线；运行记忆不是小说事实源
# 单份工具或子 Agent 结果的预览上限；不是记忆层配额。
GENERAL_AGENT_RESULT_PREVIEW_TOKENS=4000
# 模型窗口可按部署覆盖；未知模型必须配置窗口。
GENERAL_AGENT_MODEL_WINDOWS_JSON={}
# 可选官方 tokenizer.json 路径映射；未配置模型显示保守估算。
GENERAL_AGENT_TOKENIZERS_JSON={}
GENERAL_AGENT_MEMORY_AGE_DECAY_DAYS=30
GENERAL_AGENT_MEMORY_MINIMUM_RELEVANCE=0.01
GENERAL_AGENT_CAPABILITY_RETRIEVAL_LIMIT=12

# MongoDB 本地运行配置
MONGODB_HOME=C:/path/to/mongodb
MONGODB_DATA_DIR=E:/Taichu/MongoDB/data/db
MONGODB_LOG_DIR=E:/Taichu/MongoDB/log
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=taichu
